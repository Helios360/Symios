# Disable MySQL host cache to prevent intermittent Access denied errors
# when the app's connection pool opens multiple connections rapidly from a
# new Docker IP. The default host_cache_size causes a race: under parallel
# connections, the cache briefly flags the host as blocked, producing
# sporadic 500s with "Access denied for user" on otherwise valid credentials.
# See: https://dev.mysql.com/doc/refman/8.0/en/host-cache.html
[mysqld]
host_cache_size=0
mysql_native_password=ON