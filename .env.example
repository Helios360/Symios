# MySQL connection string used by mysql2 and Better Auth.
# Matches the docker-compose service (host port 3307 -> container 3306).
DATABASE_URL="mysql://symios:***@mysql:3306/symios"

# Better Auth — generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# Public URL of the app (used by Better Auth for redirects, cookies, etc.)
BETTER_AUTH_URL="https://helli0s.ddns.net/symios"

# Comma-separated extra origins allowed by Better Auth (CSRF / CORS).
BETTER_AUTH_TRUSTED_ORIGINS="https://helli0s.ddns.net,http://localhost:3001,http://192.168.1.75:3001"

# Stripe
STRIPE_PRIVATE_KEY="dfgiljhdfg"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# SvelteKit CSRF / origin validation — must match the public-facing domain.
ORIGIN="https://helli0s.ddns.net"

# Proxy headers (NGINX forwards these automatically when included via snippets/proxy-headers.conf).
PROTOCOL_HEADER="x-forwarded-proto"
HOST_HEADER="x-forwarded-host"