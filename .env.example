# MySQL connection string used by mysql2 and Better Auth.
# Matches the docker-compose service (host port 3307 -> container 3306).
DATABASE_URL="mysql://symios:symios@localhost:3307/symios"

# Better Auth — generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"

# Comma-separated extra origins allowed by Better Auth (CSRF / CORS).
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:5173"
