{
	"name": "symios",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node --env-file=.env build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"auth:generate": "npx @better-auth/cli generate --config src/lib/server/auth.ts --output src/lib/server/schema.sql",
		"auth:migrate": "npx @better-auth/cli migrate --config src/lib/server/auth.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/nodemailer": "^8.0.2",
		"@types/three": "^0.185.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"better-auth": "^1.6.19",
		"mysql2": "^3.22.5",
		"nodemailer": "^10.1.7",
		"stripe": "^22.6.0",
		"three": "^0.185.1"
	}
}
